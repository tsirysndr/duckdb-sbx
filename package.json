{
  "name": "duckdb-sbx",
  "version": "0.1.0",
  "description": "DuckDB in a bsdkrun microVM, with ZFS-branched data",
  "license": "MIT",
  "type": "module",
  "bin": {
    "duckdb-sbx": "bin/duckdb-sbx.js"
  },
  "files": [
    "bin",
    "output/**/*.js",
    "output/package.json"
  ],
  "scripts": {
    "build": "spago build",
    "test": "spago test && npm run test:cli",
    "prepare": "spago build",
    "build:bin": "spago build && node bin/ci.js build-binary",
    "test:cli": "bun test --timeout 120000 test/*.test.mjs",
    "test:e2e": "bun test --timeout 1800000 ./test/live.e2e.mjs",
    "build:release": "node bin/ci.js release"
  },
  "dependencies": {
    "@bsdkrun/sdk": "^0.8.0"
  },
  "devDependencies": {
    "purescript": "^0.15.16",
    "spago": "^1.0.5"
  }
}
